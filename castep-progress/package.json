{
  "name": "@smartcatai/castep-progress",
  "description": "DSH web 侧边栏插件：实时 CASTEP 作业进度（筛选/排序），复用 @linxin666/dsh-ssh 的 SSH 连接。",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": { "dsh": ">=0.1.2-rc.1" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0"
}
